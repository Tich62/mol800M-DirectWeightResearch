  "charter": {
    "acceptance_criteria": [
      "As of 2026-11-21, SmolLM2 research acceptance remains UNVERIFIED and UNACCEPTED: G1-G5 are open obligations requiring independently authenticated evidence before any research-complete claim."
    ],
    "beneficiaries": [
      "The owner of the isolated local Smol800M direct-weight research experiment"
    ],
    "constraints": [
      "The GitHub research-control repository is control-only (whether private or public); never upload local weights, datasets, raw logs, private local paths, security receipts, or secrets without separate review.",
      "Do not modify protected Luna services or bypass STOP/CANCEL; each full-model run requires genuine independent owner grant and verified rollback.",
      "No LoRA, conventional fine-tuning, teacher distillation or fake performance claims; preserve all original model checkpoints.",
      "Use separate clean Git checkout; never link or automatically push the frozen ACTIVE source tree to public GitHub.",
      "G1 RESEARCH ACCEPTANCE NOT ESTABLISHED (2026-11-21); still required: Independent authenticated protected worker provenance, key/response/replay custody, effective rights, source-bound QA.",
      "G2 RESEARCH ACCEPTANCE NOT ESTABLISHED (2026-11-21); still required: Owner-approved bounded 1750-second model lifecycle, cancellation, memory floors and complete rollback.",
      "G3 RESEARCH ACCEPTANCE NOT ESTABLISHED (2026-11-21); still required: Six exposed coding cases by two prompts, exact matched greedy decoding, complete raw/EOS and prompt-control accounting.",
      "G4 RESEARCH ACCEPTANCE NOT ESTABLISHED (2026-11-21); still required: One source-pinned direct-weight-only selective intervention with independent approval and no teachers/LoRA/fine-tuning.",
      "G5 RESEARCH ACCEPTANCE NOT ESTABLISHED (2026-11-21); still required: Independently controlled unseen paired quality/retention, significance, checkpoint hashes, hardware metrics and QA approval.",
      "ZzzOps PROJECT.md Status: complete denotes policy approval only, NEVER completion of G1-G5 research milestones or proof of unseen model improvement."
    ],
    "kpis": [
      {
        "baseline": "Unverified for paired unseen benchmark; historical exposed counts are not accepted",
        "cadence": "Every separately authorized candidate evaluation",
        "evidence": "Authenticated raw 192-token greedy responses, natural EOS, precommitted blind grading on at least 100 paired unseen tasks",
        "name": "Unseen complete-code-repair pass-rate vs expanded baseline",
        "target": "At least 10 absolute percentage points improvement and paired exact two-sided p<0.05",
        "why": "Verify genuine code quality on independently sealed tasks"
      },
      {
        "baseline": "Frozen V174; no independent unseen score established",
        "cadence": "Every separately authorized candidate evaluation",
        "evidence": "Authenticated same-case V174 and candidate raw responses, exact checkpoint IDs and independent grader",
        "name": "Unseen complete-code-repair pass-rate vs V174",
        "target": "At least 5 absolute percentage points improvement and paired exact two-sided p<0.05",
        "why": "Show a new weight edit actually improves over frozen V174"
      },
      {
        "baseline": "Current deployment/retention acceptance not established",
        "cadence": "Every candidate before promotion",
        "evidence": "At least 20 precommitted retention cases and independently authenticated resource and worker receipts",
        "name": "Retention and operational integrity",
        "target": "No unacceptable predeclared retention loss; proven STOP/CANCEL/rollback and real resource/latency measurements",
        "why": "Avoid regressions and false claims"
      }
    ],
    "non_goals": [
      "Claiming 9B/GPT-level performance or native 1M context without evidence",
      "Production release or Luna integration before independent QA",
      "Training/teacher/LoRA work outside the direct-weight-only experiment"
    ],
    "outcome": "Demonstrate a verifiably stronger direct-weight-only SmolLM2 checkpoint than both expanded-unedited and frozen V174 on independently controlled unseen coding repairs.",
    "precedence": "Safety and authentic owner authority > privacy and honest evidence > real coding accuracy > model speed.",
    "time_horizon": "No fixed deadline; authorized bounded research milestones with independent acceptance before any release.",
    "unacceptable_tradeoffs": [
      "Weakened authentication, cancellation or rollback to accelerate progress",
      "Publishing confidential local research sources or credentials",
      "Claiming model-quality gain from synthetic layer tests or unverified self-reported scores"
    ],
    "why_it_matters": "Distinguish real, reproducible generalization from exposed-task calibration and prompt-only improvement while preserving protected model runtimes."
  },
